# Optional analytics. Leave both blank to load no analytics at all.
# Set ONE of these before running `npm run build`.

# Cloudflare Web Analytics: the token from Cloudflare dashboard > Web Analytics > Add a site
PUBLIC_CF_BEACON_TOKEN=

# Umami: the website ID from your Umami dashboard (PUBLIC_UMAMI_SRC only if self-hosting)
PUBLIC_UMAMI_WEBSITE_ID=
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
