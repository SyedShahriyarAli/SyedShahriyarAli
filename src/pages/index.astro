<script>
	// Fetch GitHub Repos
	async function loadGitHubRepos() {
		try {
			const res = await fetch(
				"https://api.github.com/users/SyedShahriyarAli/repos",
			);
			let repos = await res.json();
			// Filter and slice like old implementation
			repos = repos
				.filter(
					(r: any) => r.language === "C#" && r.name !== "SqlStudio",
				)
				.slice(0, 6);

			const container = document.getElementById("repos-container");
			if (!container) return;

			container.innerHTML = repos
				.map(
					(repo: any) => `
				<a href="${repo.html_url}" target="_blank" class="repo-card-link">
					<div class="repo-card">
						<h4>${repo.name}</h4>
						<p>${repo.description || "No description provided."}</p>
						<div class="repo-meta">
							<span><i class="fa-solid fa-star"></i> ${repo.stargazers_count}</span>
							<span class="repo-lang"><i class="fa-solid fa-code"></i> ${repo.language}</span>
						</div>
					</div>
				</a>
			`,
				)
				.join("");
		} catch (error) {
			console.error("Failed to load GitHub repos", error);
			const container = document.getElementById("repos-container");
			if (container) {
				container.innerHTML =
					'<span style="color:red">[Error]: Connection refused by api.github.com</span>';
			}
		}
	}

	loadGitHubRepos();

	document
		.getElementById("toggleCertsBtn")
		?.addEventListener("click", (e) => {
			const btn = e.target as HTMLButtonElement;
			const hiddenCerts = document.querySelectorAll(".hidden-cert");
			hiddenCerts.forEach((cert) => {
				cert.classList.toggle("show-cert");
			});

			if (btn.innerText.includes("show_all")) {
				btn.innerHTML = "&gt; _show_less";
			} else {
				btn.innerHTML = "&gt; _show_all";
			}
		});
</script>

<style>
	/* Inline critical page styles */
	.mt-1 {
		margin-top: 0.25rem;
	}
	.mt-2 {
		margin-top: 0.5rem;
	}
	.mt-4 {
		margin-top: 1rem;
	}
	.pb-2 {
		padding-bottom: 0.5rem;
	}

	.text-sm {
		font-size: 0.875rem;
	}
	.text-xs {
		font-size: 0.75rem;
	}
	.text-muted {
		color: var(--text-muted);
	}

	.hero-content {
		display: flex;
		gap: 2rem;
		align-items: center;
		height: 100%;
	}

	.avatar {
		width: 150px;
		height: 150px;
		border-radius: 50%;
		border: 2px solid var(--accent-cyan);
		box-shadow: var(--shadow-glow);
		object-fit: cover;
	}

	.bio {
		font-size: 1.1rem;
		max-width: 600px;
	}

	.social-links {
		display: flex;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.social-links a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(255, 255, 255, 0.05);
		padding: 0.5rem 1rem;
		border-radius: 8px;
		border: 1px solid var(--border-color);
		color: var(--text-main);
	}

	.social-links a:hover {
		background: rgba(14, 165, 233, 0.1);
		border-color: var(--accent-cyan);
		color: var(--accent-cyan);
	}

	.stats-grid {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 1.5rem;
		height: 100%;
	}

	.stat-item {
		text-align: center;
	}

	.stat-value {
		font-size: 2.5rem;
		font-weight: 800;
		display: block;
		line-height: 1;
	}

	.stat-label {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--text-muted);
		text-transform: uppercase;
	}

	.edu-item {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 100%;
	}
	.edu-icon {
		font-size: 2rem;
		color: var(--accent-cyan);
	}

	.skills-container {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
	}

	.skill-tag {
		background: rgba(14, 165, 233, 0.1);
		border: 1px solid rgba(14, 165, 233, 0.3);
		color: var(--text-main);
		padding: 0.4rem 0.8rem;
		border-radius: 6px;
		font-size: 0.9rem;
		transition: all 0.2s ease;
	}

	.skill-tag:hover {
		background: rgba(14, 165, 233, 0.2);
		border-color: var(--accent-cyan);
		transform: translateY(-2px);
	}

	.timeline {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.timeline-item {
		position: relative;
		padding-left: 1.5rem;
		border-left: 1px solid var(--border-color);
	}

	.timeline-item::before {
		content: "";
		position: absolute;
		left: -4px;
		top: 6px;
		width: 7px;
		height: 7px;
		background: var(--accent-cyan);
		border-radius: 50%;
		box-shadow: 0 0 10px var(--accent-cyan);
	}

	.timeline-item h4 {
		color: var(--text-main);
		margin-bottom: 0.1rem;
	}

	.timeline-company {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--accent-cyan);
		display: block;
		margin-bottom: 0.5rem;
	}

	.timeline-item ul {
		list-style: none;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.timeline-item ul li {
		position: relative;
		padding-left: 1rem;
		margin-bottom: 0.3rem;
	}
	.timeline-item ul li::before {
		content: "▹";
		position: absolute;
		left: 0;
		color: var(--text-muted);
	}

	/* Repos loading state */
	.loading-state {
		padding: 2rem;
		text-align: center;
		color: var(--text-muted);
	}

	/* Dynamic GitHub Repo styles target */
	:global(.repos-grid) {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	:global(.repo-card-link) {
		display: block;
	}

	:global(.repo-card) {
		background: rgba(0, 0, 0, 0.2);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 1rem;
		transition: all 0.2s ease;
		height: 100%;
	}

	:global(.repo-card:hover) {
		border-color: var(--accent-cyan);
		background: rgba(14, 165, 233, 0.05);
	}

	:global(.repo-card h4) {
		color: var(--text-main);
	}

	:global(.repo-card p) {
		font-size: 0.85rem;
		margin-top: 0.4rem;
		margin-bottom: 0.8rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	:global(.repo-meta) {
		display: flex;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	:global(.repo-lang) {
		color: var(--accent-cyan);
	}

	.certs-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	.cert-item {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		background: rgba(255, 255, 255, 0.03);
		padding: 1.25rem;
		border-radius: 8px;
		border: 1px solid var(--border-color);
	}

	.cert-item h5 {
		font-size: 1.2rem;
		margin-bottom: 0.25rem;
		color: var(--text-main);
	}

	.cert-item span {
		font-size: 0.95rem;
	}

	.cert-item:hover {
		background: rgba(14, 165, 233, 0.05);
		border-color: var(--accent-cyan);
	}

	.cert-icon {
		font-size: 2rem;
		color: var(--accent-cyan);
	}

	.hidden-cert {
		display: none;
	}

	.hidden-cert.show-cert {
		display: flex;
	}

	.expand-btn-container {
		text-align: center;
	}

	#toggleCertsBtn {
		background: transparent;
		color: var(--accent-cyan);
		border: 1px dashed var(--border-color);
		padding: 0.5rem 1rem;
		border-radius: 6px;
		cursor: pointer;
		font-size: 0.9rem;
		transition: all 0.2s ease;
	}

	#toggleCertsBtn:hover {
		border-color: var(--accent-cyan);
		background: rgba(14, 165, 233, 0.05);
	}

	.footer {
		text-align: center;
		margin-top: 4rem;
		padding-bottom: 2rem;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	@media (max-width: 1024px) {
		.hero-content {
			flex-direction: column;
			text-align: center;
		}
		.social-links {
			justify-content: center;
		}
		.certs-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.certs-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
