---
export interface Props {
  path: string;
}

const { path } = Astro.props;
---

<nav class="glass-panel nav-header">
  <div class="terminal-font">
    <span class="terminal-prompt">shahriyar@portfolio:~$</span>
    <span class="path">cd {path}</span><span class="cursor">_</span>
  </div>
  <div class="links">
    <a href="#about">/readme</a>
    <a href="#experience">/experience</a>
    <a href="#skills">/skills</a>
    <a href="#projects">/projects</a>
    <a href="#certifications">/credentials</a>
  </div>
</nav>

<style>
  .nav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    margin-bottom: 2rem;
    border-radius: 12px;
  }
  
  .terminal-font {
    font-size: 1.1rem;
  }
  
  .path {
    color: var(--text-main);
  }
  
  .cursor {
    animation: blink 1s step-end infinite;
    color: var(--accent-cyan);
  }
  
  .links {
    display: flex;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  
  .links a {
    color: var(--text-muted);
  }
  
  .links a:hover {
    color: var(--accent-cyan);
  }
  
  @keyframes blink {
    50% { opacity: 0; }
  }
  
  @media (max-width: 768px) {
    .nav-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .links {
      flex-wrap: wrap;
    }
  }
</style>
