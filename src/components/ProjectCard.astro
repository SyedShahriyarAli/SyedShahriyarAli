---
import type { Project } from "../data/projects";
import EraArchitecture from "./EraArchitecture.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card card">
  <div class="card-content">
    <p class="project-meta">
      <span class="meta-sep">·</span>
      <span>{project.client}</span>
    </p>

    <h3 class="project-name">{project.name}</h3>

    <p class="project-role">
      <strong style="color: #fff">Role:</strong>
      {project.role}
    </p>
    <p class="project-problem">
      <strong style="color: #fff">Problem:</strong>
      {project.problem}
    </p>

    <div class="outcomes">
      <p class="outcomes-label">Outcomes</p>
      <ul class="project-bullets">
        {project.bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
    </div>

    <div class="project-footer">
      <div class="project-stack">
        {project.stack.map((tech) => <span class="tag">{tech}</span>)}
      </div>
      {
        project.diagram && (
          <>
            <button
              type="button"
              class="project-link diagram-btn"
              data-diagram-open={project.slug}
            >
              View architecture{" "}
              <i
                class="fa-solid fa-diagram-project"
                style="margin-left: 4px; font-size: 0.8em"
              />
            </button>
            <dialog class="diagram-dialog" data-diagram-dialog={project.slug}>
              <form method="dialog" class="diagram-close">
                <button aria-label="Close architecture diagram">×</button>
              </form>
              <div class="diagram-body">
                {project.diagram === "era" && <EraArchitecture />}
              </div>
            </dialog>
          </>
        )
      }
      {
        project.links && (
          <div class="project-links">
            {project.links.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
              >
                {link.label}{" "}
                <i
                  class="fa-solid fa-arrow-right"
                  style="margin-left: 4px; font-size: 0.8em"
                />
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-meta {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
  }

  .project-badge {
    background: rgba(56, 189, 248, 0.1);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .meta-sep {
    margin: 0 0.5rem;
    color: var(--border-strong);
  }

  .project-name {
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .project-role,
  .project-problem {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .outcomes {
    margin: 1.5rem 0;
    flex-grow: 1;
  }

  .outcomes-label {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .project-bullets {
    list-style: none;
  }

  .project-bullets li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .project-bullets li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
    opacity: 0.7;
    font-size: 0.8em;
    top: 0.2rem;
  }

  .project-footer {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--glass-border);
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-link {
    font-size: 0.875rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .diagram-btn {
    background: none;
    border: 0;
    padding: 0;
    color: var(--accent);
    cursor: pointer;
    font-family: inherit;
  }

  .diagram-dialog {
    width: min(1100px, 94vw);
    max-height: 92vh;
    margin: auto;
    padding: 1rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
    color: var(--text);
    overflow: auto;
  }

  .diagram-dialog::backdrop {
    background: rgba(0, 0, 0, 0.75);
  }

  .diagram-body {
    overflow-x: auto;
    padding-top: 1.5rem;
  }

  .diagram-close {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
  }

  .diagram-close button {
    background: var(--bg-muted);
    border: 1px solid var(--border-strong);
    color: var(--text);
    border: 0;
    border-radius: var(--radius-full);
    width: 2rem;
    height: 2rem;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-diagram-open]").forEach((btn) => {
    const dialog = document.querySelector<HTMLDialogElement>(
      `[data-diagram-dialog="${btn.dataset.diagramOpen}"]`,
    );
    btn.addEventListener("click", () => dialog?.showModal());
    dialog?.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
