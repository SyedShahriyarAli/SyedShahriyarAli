---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card card">
  <div class="card-content">
    <p class="project-meta">
      <span class="meta-sep">·</span>
      <span>{project.client}</span>
    </p>

    <h3 class="project-name">{project.name}</h3>

    <p class="project-role">
      <strong style="color: #fff">Role:</strong>
      {project.role}
    </p>
    <p class="project-problem">
      <strong style="color: #fff">Problem:</strong>
      {project.problem}
    </p>

    <div class="outcomes">
      <p class="outcomes-label">Outcomes</p>
      <ul class="project-bullets">
        {project.bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
    </div>

    <div class="project-footer">
      <div class="project-stack">
        {project.stack.map((tech) => <span class="tag">{tech}</span>)}
      </div>
      {
        project.link && (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link"
          >
            View site{" "}
            <i
              class="fa-solid fa-arrow-right"
              style="margin-left: 4px; font-size: 0.8em"
            />
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-meta {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
  }

  .project-badge {
    background: rgba(56, 189, 248, 0.1);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
  }

  .meta-sep {
    margin: 0 0.5rem;
    color: var(--border-strong);
  }

  .project-name {
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .project-role,
  .project-problem {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .outcomes {
    margin: 1.5rem 0;
    flex-grow: 1;
  }

  .outcomes-label {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .project-bullets {
    list-style: none;
  }

  .project-bullets li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .project-bullets li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
    opacity: 0.7;
    font-size: 0.8em;
    top: 0.2rem;
  }

  .project-footer {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--glass-border);
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-link {
    font-size: 0.875rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
  }
</style>
