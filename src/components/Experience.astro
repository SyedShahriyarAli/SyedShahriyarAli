---
import { experience } from "../data/experience";
---

<section id="experience" class="section">
  <div class="container" data-reveal-section>
    <h2 class="section-title">Experience</h2>
    <p class="section-desc">
      Enterprise applications and technical leadership across healthcare, FMCG, and logistics.
    </p>

    <div class="timeline">
      {
        experience.map((item) => (
          <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content card">
              <div class="timeline-header">
                <div>
                  <h3>{item.title}</h3>
                  <p class="timeline-company">{item.company}</p>
                </div>
                <span class="timeline-period">{item.period}</span>
              </div>
              <ul>
                {item.bullets.map((bullet) => (
                  <li set:html={bullet} />
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: relative;
  }
  
  .timeline::before {
    content: '';
    position: absolute;
    left: 17px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--glass-border);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 1.5rem;
    align-items: start;
    position: relative;
  }

  .timeline-marker {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 1.5rem;
    margin-left: 11px;
    box-shadow: 0 0 12px var(--accent-glow);
    z-index: 2;
    position: relative;
  }

  .timeline-content {
    padding: 1.75rem;
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .timeline-content h3 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .timeline-company {
    font-size: 1rem;
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .timeline-period {
    font-size: 0.8125rem;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--text-muted);
    white-space: nowrap;
    padding: 0.35rem 0.85rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
  }

  .timeline-content ul {
    list-style: none;
  }

  .timeline-content li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.6rem;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .timeline-content li::before {
    content: "→";
    position: absolute;
    left: 0;
    top: 0.2rem;
    color: var(--accent);
    opacity: 0.7;
    font-size: 0.8em;
  }
</style>
